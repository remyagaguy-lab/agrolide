# Copier en .env.local (jamais commité). Valeurs à renseigner dans Vercel pour la production.

# Supabase (authentification)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Administrateurs de secours (e-mails séparés par des virgules)
ADMIN_EMAILS=

# Site
NEXT_PUBLIC_SITE_URL=https://www.agrolide.org
NEXT_PUBLIC_API_URL=

# Cloudflare D1 (accès REST) et R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Divers
NEXT_PUBLIC_SENTRY_DSN=
OPENROUTER_API_KEY=
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
